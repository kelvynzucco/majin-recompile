 #include <rex/audio/audio_driver.h>
+#include <atomic>
 
 namespace rex::audio {
 
+static std::atomic<float> s_playback_frequency_ratio{1.0f};
+
+void SetPlaybackFrequencyRatio(float ratio) {
+  s_playback_frequency_ratio.store(ratio, std::memory_order_relaxed);
+}
+
+float GetPlaybackFrequencyRatio() {
+  return s_playback_frequency_ratio.load(std::memory_order_relaxed);
+}
+
 AudioDriver::AudioDriver(memory::Memory* memory) : memory_(memory) {}
 
 AudioDriver::~AudioDriver() = default;
